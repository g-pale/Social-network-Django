# Media files (загруженные пользователями)
# Игнорируем все файлы в media/, кроме .gitkeep
/media/**
!/media/
/media/*
!/media/.gitkeep
!/media/avatars/
/media/avatars/*
!/media/avatars/.gitkeep
!/media/posts/
/media/posts/*
